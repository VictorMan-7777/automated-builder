#!/usr/bin/env bash
set -euo pipefail

# run-create-project — Command scaffolding for project creation
# Issue-002 implementation: parameter parsing and normalization
# Issue-003 implementation: path resolution and validation
# Issue-005 implementation: project.yaml creation (FIRST file)
# Does NOT create other files (deferred to Issue-006, Issue-011)

# BUILDER_ROOT definition (Issue-003: use git rev-parse directly)
# BUILDER_ROOT = absolute path to the automated-builder repository root
# (the directory containing .git/, templates/, prompts/, etc.)
# NOT the umbrella projects directory that contains multiple project repositories
BUILDER_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" ||
  { echo "Error: Cannot locate automated-builder repository root" >&2; exit 1; }

# Canonicalize BUILDER_ROOT (resolve symlinks)
BUILDER_ROOT="$(cd "${BUILDER_ROOT}" && pwd -P)"

# Default parent directory (umbrella projects directory)
DEFAULT_PARENT_DIR="$(dirname "${BUILDER_ROOT}")"

# Usage text
usage() {
  cat <<EOF
Usage: run-create-project --slug <project-slug> --name "<Project Name>" --prefix <PREFIX> [--parent-dir <path>]

Creates a new project with normalized parameters.

Required Parameters:
  --slug <project-slug>     Project identifier (normalized to lowercase-hyphen format)
  --name "<Project Name>"   Human-readable project name
  --prefix <PREFIX>         Project prefix (1-4 uppercase letters)

Optional Parameters:
  --parent-dir <path>       Parent directory for project (default: ${DEFAULT_PARENT_DIR})

Examples:
  run-create-project --slug my-project --name "My Project" --prefix MP
  run-create-project --slug "My_Cool-App" --name "My Cool App" --prefix "dg"

Normalization:
  - Slug: Converts to lowercase, replaces underscores/spaces with hyphens
  - Name: Trims whitespace, normalizes internal whitespace
  - Prefix: Converts to uppercase, validates 1-4 letter format

Note: Prefix derivation is not supported (deferred to Issue-004).
      This command validates parameters but does NOT create files yet.

BUILDER_ROOT: ${BUILDER_ROOT}
Default parent-dir: ${DEFAULT_PARENT_DIR}
EOF
  exit "${1:-0}"
}

# Error handling
error() {
  echo "Error: $1" >&2
  exit 1
}

validation_error() {
  local msg="$1"
  local should_cleanup="${2:-false}"

  echo "❌ Validation Error: ${msg}" >&2

  # Cleanup logic (only for post-creation validation failures)
  if [[ "${should_cleanup}" == "true" && -n "${PROJECT_PATH}" && -d "${PROJECT_PATH}" ]]; then
    # Safety check: verify PROJECT_PATH ends with project-slug before deletion
    if [[ "${PROJECT_PATH}" =~ /${NORMALIZED_SLUG}$ ]]; then
      # Safety check: verify PROJECT_PATH is not BUILDER_ROOT
      if [[ "${PROJECT_PATH}" != "${BUILDER_ROOT}" ]]; then
        echo "🧹 Cleaning up partial project directory: ${PROJECT_PATH}" >&2
        rm -rf "${PROJECT_PATH}"
        echo "✅ Cleanup complete" >&2
      else
        echo "⚠️  CRITICAL: PROJECT_PATH matches BUILDER_ROOT. Aborting cleanup." >&2
      fi
    else
      echo "⚠️  WARNING: PROJECT_PATH does not end with project-slug. Skipping cleanup to prevent data loss." >&2
      echo "⚠️  PROJECT_PATH: ${PROJECT_PATH}" >&2
      echo "⚠️  NORMALIZED_SLUG: ${NORMALIZED_SLUG}" >&2
    fi
  fi

  exit 1
}

usage_error() {
  echo "Usage Error: $1" >&2
  echo "Run 'run-create-project --help' for usage information." >&2
  exit 2
}

# Parameter parsing
SLUG=""
NAME=""
PREFIX=""
PARENT_DIR="${DEFAULT_PARENT_DIR}"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --slug)
      SLUG="$2"
      shift 2
      ;;
    --name)
      NAME="$2"
      shift 2
      ;;
    --prefix)
      PREFIX="$2"
      shift 2
      ;;
    --parent-dir)
      PARENT_DIR="$2"
      shift 2
      ;;
    --help|-h)
      usage 0
      ;;
    *)
      usage_error "Unknown parameter: $1"
      ;;
  esac
done

# Validate required parameters
[[ -z "${SLUG}" ]] && usage_error "Missing required parameter: --slug"
[[ -z "${NAME}" ]] && usage_error "Missing required parameter: --name"
[[ -z "${PREFIX}" ]] && usage_error "Missing required parameter: --prefix"

# Normalization functions

normalize_slug() {
  local input="$1"
  # Convert to lowercase (bash 3.2 compatible)
  local normalized="$(echo "$input" | tr '[:upper:]' '[:lower:]')"
  # Replace underscores and spaces with hyphens
  normalized="${normalized//_/-}"
  normalized="${normalized// /-}"
  # Remove leading hyphens
  normalized="${normalized#"${normalized%%[!-]*}"}"
  # Remove trailing hyphens
  normalized="${normalized%"${normalized##*[!-]}"}"
  echo "${normalized}"
}

normalize_name() {
  local input="$1"
  # Trim leading/trailing whitespace
  local normalized="${input#"${input%%[![:space:]]*}"}"
  normalized="${normalized%"${normalized##*[![:space:]]}"}"
  # Normalize internal whitespace to single spaces
  normalized="$(echo "${normalized}" | tr -s '[:space:]' ' ')"
  echo "${normalized}"
}

normalize_prefix() {
  local input="$1"
  # Trim whitespace
  local normalized="${input#"${input%%[![:space:]]*}"}"
  normalized="${normalized%"${normalized##*[![:space:]]}"}"
  # Convert to uppercase (bash 3.2 compatible)
  normalized="$(echo "$normalized" | tr '[:lower:]' '[:upper:]')"
  echo "${normalized}"
}

normalize_parent_dir() {
  local input="$1"
  # Expand to absolute path
  if [[ "${input:0:1}" != "/" ]]; then
    input="$(cd "${input}" 2>/dev/null && pwd)" || validation_error "Parent directory does not exist: ${input}"
  fi
  echo "${input}"
}

# Apply normalization
NORMALIZED_SLUG="$(normalize_slug "${SLUG}")"
NORMALIZED_NAME="$(normalize_name "${NAME}")"
NORMALIZED_PREFIX="$(normalize_prefix "${PREFIX}")"
NORMALIZED_PARENT_DIR="$(normalize_parent_dir "${PARENT_DIR}")"

# Validation (basic sanity checks only, strict validation deferred to artifact-write time)

# Slug validation: ^[a-z][a-z0-9-]*[a-z0-9]$
if [[ ! "${NORMALIZED_SLUG}" =~ ^[a-z][a-z0-9-]*[a-z0-9]$ ]]; then
  validation_error "Invalid slug format after normalization: '${NORMALIZED_SLUG}' (expected: lowercase letters, numbers, hyphens; must start with letter, end with letter or number)"
fi

# Name validation: non-empty
if [[ -z "${NORMALIZED_NAME}" ]]; then
  validation_error "Project name cannot be empty after normalization"
fi

# Prefix validation: ^[A-Z]{1,4}$
if [[ ! "${NORMALIZED_PREFIX}" =~ ^[A-Z]{1,4}$ ]]; then
  validation_error "Invalid prefix format after normalization: '${NORMALIZED_PREFIX}' (expected: 1-4 uppercase letters, got '${PREFIX}' → '${NORMALIZED_PREFIX}')"
fi

# Parent-dir validation: exists (basic check from Issue-002)
if [[ ! -d "${NORMALIZED_PARENT_DIR}" ]]; then
  validation_error "Parent directory does not exist: ${NORMALIZED_PARENT_DIR}"
fi

# Path Resolution and Validation (Issue-003)

# Validate PARENT_DIR writability
if [[ ! -w "${NORMALIZED_PARENT_DIR}" ]]; then
  validation_error "Parent directory is not writable: ${NORMALIZED_PARENT_DIR}"
fi

# Canonicalize PARENT_DIR (resolve symlinks)
PARENT_DIR="$(cd "${NORMALIZED_PARENT_DIR}" && pwd -P)"

# Compute PROJECT_PATH
PROJECT_PATH="${PARENT_DIR}/${NORMALIZED_SLUG}"

# Check project path doesn't already exist
if [[ -e "${PROJECT_PATH}" ]]; then
  validation_error "Project directory already exists: ${PROJECT_PATH}"
fi

# Verify sibling relationship (using canonicalized paths)
if [[ "$(dirname "${PROJECT_PATH}")" != "$(dirname "${BUILDER_ROOT}")" ]]; then
  validation_error "Project must be sibling to automated-builder. Expected parent: $(dirname "${BUILDER_ROOT}"), got: $(dirname "${PROJECT_PATH}")"
fi

# Check no nesting (using canonicalized paths)
if [[ "${PROJECT_PATH}" == "${BUILDER_ROOT}"* ]]; then
  validation_error "Invalid nesting: project cannot be inside automated-builder"
fi

if [[ "${BUILDER_ROOT}" == "${PROJECT_PATH}"* ]]; then
  validation_error "Invalid nesting: automated-builder cannot be inside project"
fi

# Verify relative path invariant (using canonicalized paths)
RELATIVE_BUILDER_FROM_PROJECT="$(cd "${PARENT_DIR}" && cd automated-builder 2>/dev/null && pwd -P)" ||
  validation_error "Relative path invariant violated: cannot reach automated-builder from parent directory"

if [[ "${RELATIVE_BUILDER_FROM_PROJECT}" != "${BUILDER_ROOT}" ]]; then
  validation_error "Relative path invariant violated: ../automated-builder does not resolve to BUILDER_ROOT (expected: ${BUILDER_ROOT}, got: ${RELATIVE_BUILDER_FROM_PROJECT})"
fi

# Project Creation (Issue-005)

# 1. Create project root directory
mkdir -p "${PROJECT_PATH}" || validation_error "Cannot create project directory: ${PROJECT_PATH}"

# 2. Verify template exists
TEMPLATE_PATH="${BUILDER_ROOT}/templates/project/project.yaml.tmpl"
if [[ ! -f "${TEMPLATE_PATH}" ]]; then
  validation_error "Template not found: ${TEMPLATE_PATH}"
fi

# 3. Get current date
CURRENT_DATE="$(date +%Y-%m-%d)"

# 4. Escape values for safe sed substitution
# Escape '/', '&', and '\' characters to prevent sed interpretation
escape_sed() {
  local value="$1"
  # Escape backslashes first, then forward slashes, then ampersands
  value="${value//\\/\\\\}"
  value="${value//\//\\/}"
  value="${value//&/\\&}"
  echo "$value"
}

ESCAPED_SLUG="$(escape_sed "${NORMALIZED_SLUG}")"
ESCAPED_NAME="$(escape_sed "${NORMALIZED_NAME}")"
ESCAPED_PREFIX="$(escape_sed "${NORMALIZED_PREFIX}")"
ESCAPED_DATE="$(escape_sed "${CURRENT_DATE}")"

# 5. Render template with safe token substitution
# Use '|' as sed delimiter to avoid conflicts with escaped '/'
cat "${TEMPLATE_PATH}" \
  | sed "s|{project-slug}|${ESCAPED_SLUG}|g" \
  | sed "s|{Project Name}|${ESCAPED_NAME}|g" \
  | sed "s|{PREFIX}|${ESCAPED_PREFIX}|g" \
  | sed "s|{YYYY-MM-DD}|${ESCAPED_DATE}|g" \
  > "${PROJECT_PATH}/project.yaml"

# 6. Validate created file
if [[ ! -f "${PROJECT_PATH}/project.yaml" ]]; then
  validation_error "Failed to create project.yaml"
fi

# 7. Check for unresolved tokens
if grep -q '{.*}' "${PROJECT_PATH}/project.yaml"; then
  UNRESOLVED=$(grep -o '{[^}]*}' "${PROJECT_PATH}/project.yaml" | head -1)
  validation_error "Unresolved token in project.yaml: ${UNRESOLVED}"
fi

# 8. Validate file permissions
if [[ ! -r "${PROJECT_PATH}/project.yaml" ]]; then
  validation_error "project.yaml is not readable"
fi

# === Issue-006: Create remaining bootstrap files from project.yaml ===

# Read identity values from project.yaml (source-of-truth)
read_yaml_field() {
  local file="$1"
  local field="$2"
  # Extract value from identity: block only using bounded awk extraction
  # awk extracts lines BETWEEN "identity:" and next top-level key (exclusive of both endpoints)
  # then grep searches only within that extracted block
  local value="$(awk '/^identity:/ {in_identity=1; next} /^[a-z_]+:/ {if (in_identity) exit} in_identity {print}' "${file}" | grep "^  ${field}:" | head -1 | sed 's/^  [^:]*: *//' | sed 's/^"\(.*\)"$/\1/' | sed "s/^'\(.*\)'$/\1/")"
  echo "${value}"
}

PROJECT_YAML="${PROJECT_PATH}/project.yaml"

# Verify project.yaml exists and is readable (should already be true from Issue-005)
if [[ ! -f "${PROJECT_YAML}" ]]; then
  validation_error "Cannot read project.yaml: file missing"
fi
if [[ ! -r "${PROJECT_YAML}" ]]; then
  validation_error "Cannot read project.yaml: file not readable"
fi

# Verify identity: block exists (scoped extraction)
if ! grep -q "^identity:" "${PROJECT_YAML}"; then
  validation_error "Invalid project.yaml structure: missing identity: block"
fi

# Extract identity values from identity: block (source-of-truth)
IDENTITY_SLUG="$(read_yaml_field "${PROJECT_YAML}" "slug")"
IDENTITY_NAME="$(read_yaml_field "${PROJECT_YAML}" "name")"
IDENTITY_PREFIX="$(read_yaml_field "${PROJECT_YAML}" "prefix")"
IDENTITY_CREATED="$(read_yaml_field "${PROJECT_YAML}" "created")"

# Validate extracted values (basic non-empty check)
[[ -z "${IDENTITY_SLUG}" ]] && validation_error "Invalid project.yaml structure: missing identity.slug"
[[ -z "${IDENTITY_NAME}" ]] && validation_error "Invalid project.yaml structure: missing identity.name"
[[ -z "${IDENTITY_PREFIX}" ]] && validation_error "Invalid project.yaml structure: missing identity.prefix"
[[ -z "${IDENTITY_CREATED}" ]] && validation_error "Invalid project.yaml structure: missing identity.created"

# Create directories with .gitkeep
mkdir -p "${PROJECT_PATH}/phases" || validation_error "Cannot create phases directory"
touch "${PROJECT_PATH}/phases/.gitkeep" || validation_error "Cannot create phases/.gitkeep"

mkdir -p "${PROJECT_PATH}/docs/system/outputs" || validation_error "Cannot create docs/system/outputs directory"
touch "${PROJECT_PATH}/docs/system/outputs/.gitkeep" || validation_error "Cannot create docs/system/outputs/.gitkeep"

# Escape values for safe sed substitution (reuse from Issue-005)
ESCAPED_SLUG="$(escape_sed "${IDENTITY_SLUG}")"
ESCAPED_NAME="$(escape_sed "${IDENTITY_NAME}")"
ESCAPED_PREFIX="$(escape_sed "${IDENTITY_PREFIX}")"
ESCAPED_CREATED="$(escape_sed "${IDENTITY_CREATED}")"

# Render each template
render_template() {
  local template_name="$1"
  local output_file="$2"

  local template_path="${BUILDER_ROOT}/templates/project/${template_name}.tmpl"

  # Verify template exists
  if [[ ! -f "${template_path}" ]]; then
    validation_error "Template not found: ${template_path}"
  fi

  # Render template with safe token substitution (use '|' delimiter)
  cat "${template_path}" \
    | sed "s|{project-slug}|${ESCAPED_SLUG}|g" \
    | sed "s|{Project Slug}|${ESCAPED_SLUG}|g" \
    | sed "s|{Project Name}|${ESCAPED_NAME}|g" \
    | sed "s|{PREFIX}|${ESCAPED_PREFIX}|g" \
    | sed "s|{YYYY-MM-DD}|${ESCAPED_CREATED}|g" \
    > "${output_file}"

  # Validate file created
  if [[ ! -f "${output_file}" ]]; then
    validation_error "Failed to create ${output_file}"
  fi

  # Check for unresolved allowed tokens (explicit pattern matching)
  if grep -E '\{(project-slug|Project Slug|Project Name|PREFIX|YYYY-MM-DD)\}' "${output_file}" >/dev/null 2>&1; then
    UNRESOLVED=$(grep -oE '\{(project-slug|Project Slug|Project Name|PREFIX|YYYY-MM-DD)\}' "${output_file}" | head -1)
    validation_error "Unresolved token in ${output_file}: ${UNRESOLVED}"
  fi

  # Validate file readable
  if [[ ! -r "${output_file}" ]]; then
    validation_error "${output_file} is not readable"
  fi
}

# Create bootstrap files
render_template "index.md" "${PROJECT_PATH}/index.md"
render_template "prd.md" "${PROJECT_PATH}/prd.md"
render_template "roadmap.md" "${PROJECT_PATH}/roadmap.md"
render_template "iteration-log.md" "${PROJECT_PATH}/iteration-log.md"
render_template "builder-manifest.yaml" "${PROJECT_PATH}/builder-manifest.yaml"

# Verify all required files exist (8 files total: 1 + 5 + 2 .gitkeep)
REQUIRED_FILES=(
  "project.yaml"
  "index.md"
  "prd.md"
  "roadmap.md"
  "iteration-log.md"
  "builder-manifest.yaml"
  "phases/.gitkeep"
  "docs/system/outputs/.gitkeep"
)

for file in "${REQUIRED_FILES[@]}"; do
  if [[ ! -f "${PROJECT_PATH}/${file}" ]]; then
    validation_error "Required file missing: ${file}"
  fi
done

# === Issue-011: Deploy ai-process.md ===

# Template path and output path
AI_PROCESS_TEMPLATE="${BUILDER_ROOT}/templates/project/ai-process.md.tmpl"
AI_PROCESS_OUTPUT="${PROJECT_PATH}/docs/system/ai-process.md"

# Verify template exists
if [[ ! -f "${AI_PROCESS_TEMPLATE}" ]]; then
  validation_error "Template not found: ${AI_PROCESS_TEMPLATE}"
fi

# Verify docs/system/ directory exists (created in Issue-006)
if [[ ! -d "${PROJECT_PATH}/docs/system" ]]; then
  validation_error "docs/system/ directory missing (should have been created in Issue-006)"
fi

# Render template with safe token substitution (reuse escaped values from Issue-006)
cat "${AI_PROCESS_TEMPLATE}" \
  | sed "s|{project-slug}|${ESCAPED_SLUG}|g" \
  | sed "s|{Project Name}|${ESCAPED_NAME}|g" \
  | sed "s|{PREFIX}|${ESCAPED_PREFIX}|g" \
  | sed "s|{YYYY-MM-DD}|${ESCAPED_CREATED}|g" \
  > "${AI_PROCESS_OUTPUT}"

# Validate file created
if [[ ! -f "${AI_PROCESS_OUTPUT}" ]]; then
  validation_error "Failed to create docs/system/ai-process.md"
fi

# Check for unresolved allowed tokens (explicit pattern matching)
if grep -E '\{(project-slug|Project Name|PREFIX|YYYY-MM-DD)\}' "${AI_PROCESS_OUTPUT}" >/dev/null 2>&1; then
  UNRESOLVED=$(grep -oE '\{(project-slug|Project Name|PREFIX|YYYY-MM-DD)\}' "${AI_PROCESS_OUTPUT}" | head -1)
  validation_error "Unresolved placeholders in ai-process.md: ${UNRESOLVED}"
fi

# Verify prefix is present in anchored line: "**Prefix**: <PREFIX>"
# This ensures the prefix appears in the correct metadata location, not just anywhere
if ! grep -q "^\*\*Prefix\*\*: ${IDENTITY_PREFIX}$" "${AI_PROCESS_OUTPUT}"; then
  validation_error "Prefix not set in ai-process.md (expected anchored line: **Prefix**: ${IDENTITY_PREFIX})"
fi

# Validate file readable
if [[ ! -r "${AI_PROCESS_OUTPUT}" ]]; then
  validation_error "Cannot read: docs/system/ai-process.md"
fi

# Verify all 9 required bootstrap files exist (final count)
ALL_REQUIRED_FILES=(
  "project.yaml"
  "index.md"
  "prd.md"
  "roadmap.md"
  "iteration-log.md"
  "builder-manifest.yaml"
  "phases/.gitkeep"
  "docs/system/outputs/.gitkeep"
  "docs/system/ai-process.md"
)

for file in "${ALL_REQUIRED_FILES[@]}"; do
  if [[ ! -f "${PROJECT_PATH}/${file}" ]]; then
    validation_error "Required file missing: ${file}"
  fi
done

# === Issue-008: Deploy pending-items-rules.md ===

# Template path and output path
PENDING_ITEMS_TEMPLATE="${BUILDER_ROOT}/templates/project/pending-items-rules.md.tmpl"
PENDING_ITEMS_OUTPUT="${PROJECT_PATH}/docs/system/pending-items-rules.md"

# Verify template exists
if [[ ! -f "${PENDING_ITEMS_TEMPLATE}" ]]; then
  validation_error "Template not found: ${PENDING_ITEMS_TEMPLATE}"
fi

# Verify docs/system/outputs/ directory exists (created in Issue-006)
# This implicitly confirms docs/system/ exists (parent of outputs/)
if [[ ! -d "${PROJECT_PATH}/docs/system/outputs" ]]; then
  validation_error "docs/system/outputs/ directory missing (should have been created in Issue-006)"
fi

# Render template with safe token substitution (reuse escaped values from Issue-006/011)
cat "${PENDING_ITEMS_TEMPLATE}" \
  | sed "s|{project-slug}|${ESCAPED_SLUG}|g" \
  | sed "s|{Project Name}|${ESCAPED_NAME}|g" \
  | sed "s|{PREFIX}|${ESCAPED_PREFIX}|g" \
  > "${PENDING_ITEMS_OUTPUT}"

# Validate file created
if [[ ! -f "${PENDING_ITEMS_OUTPUT}" ]]; then
  validation_error "Failed to create docs/system/pending-items-rules.md"
fi

# Check for unresolved allowed tokens (explicit pattern matching)
# Only 3 tokens for this template: project-slug, Project Name, PREFIX
if grep -E '\{(project-slug|Project Name|PREFIX)\}' "${PENDING_ITEMS_OUTPUT}" >/dev/null 2>&1; then
  UNRESOLVED=$(grep -oE '\{(project-slug|Project Name|PREFIX)\}' "${PENDING_ITEMS_OUTPUT}" | head -1)
  validation_error "Unresolved token in pending-items-rules.md: ${UNRESOLVED}"
fi

# Validate file readable
if [[ ! -r "${PENDING_ITEMS_OUTPUT}" ]]; then
  validation_error "Cannot read: docs/system/pending-items-rules.md"
fi

# Verify required artifacts from dependencies exist (Issues 005, 006, 011)
ISSUE_008_DEPENDENCIES=(
  "project.yaml"                      # Issue-005
  "docs/system/outputs/.gitkeep"      # Issue-006
  "docs/system/ai-process.md"         # Issue-011
)

for file in "${ISSUE_008_DEPENDENCIES[@]}"; do
  if [[ ! -f "${PROJECT_PATH}/${file}" ]]; then
    validation_error "Dependency artifact missing: ${file}"
  fi
done

# ============================================================================
# Issue-009: End-to-End Validation
# ============================================================================

echo ""
echo "Running end-to-end validation checks..."

# Check 1: Project directory exists
if [[ ! -d "${PROJECT_PATH}" ]]; then
  validation_error "Project directory does not exist: ${PROJECT_PATH}" true
fi

# Check 2: project.yaml valid (already validated in Issue-005, verify again)
if [[ ! -f "${PROJECT_PATH}/project.yaml" ]]; then
  validation_error "Identity file missing: project.yaml" true
fi

# Check 3: All P-084 bootstrap artifacts exist
ALL_REQUIRED_FILES=(
  "project.yaml"
  "index.md"
  "prd.md"
  "roadmap.md"
  "iteration-log.md"
  "builder-manifest.yaml"
  "phases/.gitkeep"
  "docs/system/outputs/.gitkeep"
  "docs/system/ai-process.md"
  "docs/system/pending-items-rules.md"
)

for file in "${ALL_REQUIRED_FILES[@]}"; do
  if [[ ! -f "${PROJECT_PATH}/${file}" ]]; then
    validation_error "Required file missing: ${file}" true
  fi
done

# Check 4: No empty files (.gitkeep files are allowed to be empty)
for file in "${ALL_REQUIRED_FILES[@]}"; do
  if [[ "${file}" == *".gitkeep" ]]; then
    continue
  fi

  if [[ ! -s "${PROJECT_PATH}/${file}" ]]; then
    validation_error "Empty file detected: ${file}" true
  fi
done

# Check 5: YAML syntax validation (using yq if available, otherwise skip with warning)
if command -v yq >/dev/null 2>&1; then
  # Validate project.yaml is parseable YAML
  if ! yq eval '.' "${PROJECT_PATH}/project.yaml" >/dev/null 2>&1; then
    validation_error "Invalid YAML syntax in project.yaml" true
  fi

  # Validate builder-manifest.yaml is parseable YAML
  if ! yq eval '.' "${PROJECT_PATH}/builder-manifest.yaml" >/dev/null 2>&1; then
    validation_error "Invalid YAML syntax in builder-manifest.yaml" true
  fi
else
  echo "⚠️  yq not installed, skipping YAML syntax validation"
  echo "   Install with: brew install yq"
fi

# Check 6: builder-manifest.yaml contains identity_source reference
if ! grep -q "identity_source:.*project.yaml" "${PROJECT_PATH}/builder-manifest.yaml"; then
  validation_error "Missing identity_source reference in builder-manifest.yaml" true
fi

# Check 7: Governance reference paths resolve (basic check - verify relative path format)
if ! grep -q "governance:" "${PROJECT_PATH}/builder-manifest.yaml"; then
  validation_error "No governance section found in builder-manifest.yaml" true
fi

# Check governance.references paths start with ../automated-builder
GOVERNANCE_REFS=$(grep -A 10 "^  references:" "${PROJECT_PATH}/builder-manifest.yaml" | grep "    -" | sed 's/.*- //' || echo "")
if [[ -z "${GOVERNANCE_REFS}" ]]; then
  validation_error "No governance references found in builder-manifest.yaml" true
fi

# Verify each reference starts with ../automated-builder
while IFS= read -r ref_path; do
  if [[ ! "${ref_path}" =~ ^\.\./automated-builder/ ]]; then
    validation_error "Invalid governance reference (must start with ../automated-builder/): ${ref_path}" true
  fi
done <<< "${GOVERNANCE_REFS}"

# Check 8: phases/ contains only .gitkeep
PHASES_CONTENTS=$(ls -A "${PROJECT_PATH}/phases/" 2>/dev/null | grep -v "^\.gitkeep$" || true)
if [[ -n "${PHASES_CONTENTS}" ]]; then
  validation_error "Unexpected files in phases/: ${PHASES_CONTENTS}" true
fi

# Check 9: docs/system/outputs/ contains only .gitkeep
OUTPUTS_CONTENTS=$(ls -A "${PROJECT_PATH}/docs/system/outputs/" 2>/dev/null | grep -v "^\.gitkeep$" || true)
if [[ -n "${OUTPUTS_CONTENTS}" ]]; then
  validation_error "Unexpected files in docs/system/outputs/: ${OUTPUTS_CONTENTS}" true
fi

# Check 10-12: Identity consistency checks (values from project.yaml match across files)
# Read identity values from project.yaml (source-of-truth)
IDENTITY_SLUG=$(read_yaml_field "${PROJECT_PATH}/project.yaml" "slug")
IDENTITY_NAME=$(read_yaml_field "${PROJECT_PATH}/project.yaml" "name")
IDENTITY_PREFIX=$(read_yaml_field "${PROJECT_PATH}/project.yaml" "prefix")
IDENTITY_CREATED=$(read_yaml_field "${PROJECT_PATH}/project.yaml" "created")

# Verify values are non-empty
if [[ -z "${IDENTITY_SLUG}" ]]; then
  validation_error "Empty slug in project.yaml" true
fi
if [[ -z "${IDENTITY_NAME}" ]]; then
  validation_error "Empty name in project.yaml" true
fi
if [[ -z "${IDENTITY_PREFIX}" ]]; then
  validation_error "Empty prefix in project.yaml" true
fi
if [[ -z "${IDENTITY_CREATED}" ]]; then
  validation_error "Empty created date in project.yaml" true
fi

# Check 11: No unresolved placeholders (explicit token pattern check)
# Check all created files for unresolved tokens
for file in "index.md" "prd.md" "roadmap.md" "iteration-log.md" "builder-manifest.yaml" "docs/system/ai-process.md" "docs/system/pending-items-rules.md"; do
  if grep -E '\{(project-slug|Project Name|PREFIX|YYYY-MM-DD)\}' "${PROJECT_PATH}/${file}" >/dev/null 2>&1; then
    UNRESOLVED_TOKEN=$(grep -oE '\{(project-slug|Project Name|PREFIX|YYYY-MM-DD)\}' "${PROJECT_PATH}/${file}" | head -1)
    validation_error "Unresolved token in ${file}: ${UNRESOLVED_TOKEN}" true
  fi
done

# Check 12: Consistency check - slug appears in index.md
if ! grep -q "${IDENTITY_SLUG}" "${PROJECT_PATH}/index.md"; then
  validation_error "Inconsistency detected: project-slug missing in index.md" true
fi

# Check 12: Consistency check - prefix appears in pending-items-rules.md
if ! grep -q "${IDENTITY_PREFIX}" "${PROJECT_PATH}/docs/system/pending-items-rules.md"; then
  validation_error "Inconsistency detected: prefix missing in pending-items-rules.md" true
fi

# Check 12: Consistency check - prefix appears in ai-process.md (anchored line)
if ! grep -q "^\*\*Prefix\*\*: ${IDENTITY_PREFIX}$" "${PROJECT_PATH}/docs/system/ai-process.md"; then
  validation_error "Inconsistency detected: prefix not found in ai-process.md anchored line" true
fi

# Check 13: Prefix determined and set (already verified above with non-empty check)

# Check 14: Path resolution invariants satisfied (already verified during pre-creation, verify again)
# Verify PROJECT_PATH and BUILDER_ROOT are siblings
if [[ "$(dirname "${PROJECT_PATH}")" != "$(dirname "${BUILDER_ROOT}")" ]]; then
  validation_error "Path invariant violated: not siblings" true
fi

# Verify relative path from PROJECT_PATH resolves to BUILDER_ROOT
RELATIVE_BUILDER=$(cd "${PROJECT_PATH}" && realpath "../automated-builder" 2>/dev/null || echo "")
if [[ "${RELATIVE_BUILDER}" != "${BUILDER_ROOT}" ]]; then
  validation_error "Path invariant violated: relative path does not resolve to builder root" true
fi

# Check 15: No governance files duplicated (docs/system/ contains only allowed files)
# Allowed files in docs/system/: ai-process.md, pending-items-rules.md, outputs/ subdirectory
DISALLOWED_PATTERNS=(
  "planning.md"
  "builder.md"
  "gateway.md"
  "git.md"
  "issue-resolution.md"
  "prompts"
  "templates"
)

for pattern in "${DISALLOWED_PATTERNS[@]}"; do
  if [[ -e "${PROJECT_PATH}/docs/system/${pattern}" ]]; then
    validation_error "Governance file copied: docs/system/${pattern}" true
  fi
done

# Verify docs/system/ contains only allowed files
DOCS_SYSTEM_CONTENTS=$(ls -A "${PROJECT_PATH}/docs/system/" 2>/dev/null | grep -v "^ai-process.md$" | grep -v "^pending-items-rules.md$" | grep -v "^outputs$" || true)
if [[ -n "${DOCS_SYSTEM_CONTENTS}" ]]; then
  validation_error "Unexpected files in docs/system/: ${DOCS_SYSTEM_CONTENTS}" true
fi

echo "✅ All validation checks passed"
echo ""

# ============================================================================
# Success Output
# ============================================================================

# Success: print normalized values, path resolution, and project creation
echo "✅ Parameter validation successful"
echo "✅ Path resolution successful"
echo "✅ project.yaml created and validated"
echo "✅ All bootstrap files created successfully"
echo "✅ ai-process.md deployed successfully"
echo "✅ pending-items-rules.md deployed successfully"
echo ""
echo "Normalized Parameters:"
echo "  project-slug: ${NORMALIZED_SLUG}"
echo "  project-name: ${NORMALIZED_NAME}"
echo "  prefix:       ${NORMALIZED_PREFIX}"
echo "  parent-dir:   ${NORMALIZED_PARENT_DIR}"
echo ""
echo "Resolved Paths:"
echo "  BUILDER_ROOT: ${BUILDER_ROOT}"
echo "  PARENT_DIR:   ${PARENT_DIR}"
echo "  PROJECT_PATH: ${PROJECT_PATH}"
echo ""
echo "Created Files:"
echo "  project.yaml:         ${PROJECT_PATH}/project.yaml"
echo "  index.md:             ${PROJECT_PATH}/index.md"
echo "  prd.md:               ${PROJECT_PATH}/prd.md"
echo "  roadmap.md:           ${PROJECT_PATH}/roadmap.md"
echo "  iteration-log.md:     ${PROJECT_PATH}/iteration-log.md"
echo "  builder-manifest.yaml: ${PROJECT_PATH}/builder-manifest.yaml"
echo "  ai-process.md:        ${PROJECT_PATH}/docs/system/ai-process.md"
echo "  pending-items-rules.md: ${PROJECT_PATH}/docs/system/pending-items-rules.md"
echo ""
echo "Created Directories:"
echo "  phases/:              ${PROJECT_PATH}/phases/"
echo "  docs/system/outputs/: ${PROJECT_PATH}/docs/system/outputs/"
echo ""
echo "Path Invariants:"
echo "  ✅ Sibling structure verified"
echo "  ✅ No nesting detected"
echo "  ✅ Relative path invariant satisfied"
echo ""
echo "Validation Summary:"
echo "  ✅ YAML syntax validation passed"
echo "  ✅ Identity consistency verified"
echo "  ✅ Governance protection verified"
echo "  ✅ All required files exist and non-empty"
echo "  ✅ Directory structure validated"
echo "  ✅ Path resolution invariants satisfied"
echo ""
echo "Bootstrap Complete:"
echo "  ✅ All P-084 bootstrap artifacts deployed"
echo "  ✅ AI Process Contract deployed"
echo "  ✅ Namespace mapping documented (P-### → ${NORMALIZED_PREFIX}-###)"
echo "  ✅ Ready for project planning and building"
echo ""
echo "Project created: ${PROJECT_PATH}"
echo "Identity file: ${PROJECT_PATH}/project.yaml"
echo ""
